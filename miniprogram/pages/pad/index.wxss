/* pages/pad/index.wxss — 深色上位机界面（沿用 app.wxss 令牌） */

.pad {
  padding: 24rpx 24rpx 60rpx;
  padding-bottom: calc(60rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

/* ---------- 顶栏 ---------- */
.statusbar { display: flex; align-items: center; margin-bottom: 24rpx; }

.brand-text { display: flex; flex-direction: column; flex: 1; min-width: 0; }
.brand-title { font-size: 30rpx; font-weight: 600; }
.brand-sub { font-size: 22rpx; color: var(--text-3); }

.status {
  margin-left: 16rpx;
  display: flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  background: var(--surface-2);
  font-size: 22rpx;
  color: var(--text-2);
  max-width: 48%;
}
.status .dot {
  width: 12rpx; height: 12rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  background: var(--text-3);
  flex: 0 0 auto;
}
.status--live { color: var(--ok); border-color: rgba(62, 207, 142, 0.4); }
.status--live .dot { background: var(--ok); }
.status--loading { color: var(--warn); border-color: rgba(240, 180, 41, 0.4); }
.status--loading .dot { background: var(--warn); }
.status--error { color: var(--danger); border-color: rgba(242, 96, 79, 0.4); }
.status--error .dot { background: var(--danger); }

/* ---------- 通用行 ---------- */
.actions { display: flex; margin-bottom: 16rpx; }
.actions .btn { flex: 1; }
.actions .btn:first-child { margin-right: 16rpx; }

.row { display: flex; align-items: center; justify-content: space-between; padding-top: 8rpx; }
.row-label { font-size: 24rpx; color: var(--text-3); }
.bridge-status { font-size: 24rpx; color: var(--text-2); }

/* ---------- 预设网格 ---------- */
.preset-grid { display: flex; flex-wrap: wrap; }
.preset {
  width: 23.5%;
  margin: 0 2% 12rpx 0;
  height: 92rpx;
  padding: 0;
  border-radius: 14rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--line);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
}
.preset:nth-child(4n) { margin-right: 0; }
.preset-zh { font-size: 24rpx; color: var(--text); }
.preset-en { font-size: 18rpx; color: var(--text-3); }

/* ---------- 滑杆 ---------- */
.finger-row { display: flex; align-items: center; margin-bottom: 10rpx; }
.finger-name { width: 96rpx; flex: 0 0 auto; font-size: 24rpx; color: var(--text-2); }
.finger-slider { flex: 1; margin: 0 12rpx; }
.finger-val {
  width: 150rpx; flex: 0 0 auto; text-align: right;
  font-size: 22rpx; color: var(--text-3);
  font-variant-numeric: tabular-nums;
}

/* ---------- 自定义指令 ---------- */
.cmd-row { display: flex; align-items: center; }
.cmd-input {
  flex: 1;
  height: 76rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--line);
  color: var(--text);
  font-size: 26rpx;
}

.ph { color: var(--text-3); }

/* ---------- 标定 ---------- */
.cal-row { margin-bottom: 20rpx; }
.cal-name { display: block; font-size: 24rpx; color: var(--text-2); margin-bottom: 8rpx; }
.cal-fields { display: flex; flex-wrap: wrap; }
.cal-item { display: flex; align-items: center; margin: 0 20rpx 8rpx 0; }
.cal-tag { font-size: 22rpx; color: var(--text-3); margin-right: 8rpx; }
.cal-input {
  width: 96rpx;
  height: 60rpx;
  padding: 0 10rpx;
  text-align: center;
  border-radius: 12rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--line);
  color: var(--text);
  font-size: 24rpx;
}

.btn.tiny {
  height: 60rpx;
  padding: 0 18rpx;
  margin-left: 8rpx;
  font-size: 22rpx;
  border-radius: 12rpx;
  line-height: 60rpx;
}

/* ---------- 说明与日志 ---------- */
.foot-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.5;
}

.log {
  max-height: 320rpx;
  overflow-y: auto;
  padding: 16rpx;
  border-radius: 14rpx;
  background: var(--canvas-bg);
  border: 1rpx solid var(--line);
}
.log-line {
  display: block;
  font-size: 22rpx;
  color: var(--text-2);
  font-family: "SF Mono", Consolas, monospace;
  line-height: 1.6;
  word-break: break-all;
}
.log-empty { font-size: 22rpx; color: var(--text-3); }
