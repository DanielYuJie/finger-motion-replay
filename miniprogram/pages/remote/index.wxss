/* pages/remote/index.wxss — PC 推理模式 */
.wrap { position: relative; height: 100vh; background: #14161A; }

.cam { position: absolute; left: 0; top: 0; width: 100%; height: 100vh; }

.panel {
  position: absolute; left: 16rpx; right: 16rpx; bottom: 16rpx;
  background: rgba(20, 22, 26, 0.92);
  border: 1rpx solid rgba(255,255,255,0.10);
  border-radius: 20rpx; padding: 18rpx 18rpx 12rpx;
}

.seg { display: flex; align-items: center; }
.url {
  flex: 1; min-width: 0;
  height: 64rpx; line-height: 64rpx; padding: 0 16rpx;
  background: rgba(255,255,255,0.06); border-radius: 12rpx;
  color: #E8E6E1; font-size: 24rpx;
}
.btn.sm { margin-left: 12rpx; padding: 0 16rpx; height: 64rpx; line-height: 64rpx; font-size: 24rpx; }

.stat { display: flex; align-items: center; margin-top: 16rpx; }
.dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #8A8F98; margin-right: 10rpx; }
.stat.ok .dot { background: #52C41A; }
.stat.warn .dot { background: #FAAD14; }
.txt { flex: 1; color: #C9CDD4; font-size: 24rpx; }
.meta { color: #8A8F98; font-size: 22rpx; }

.fingers { display: flex; flex-wrap: wrap; margin-top: 16rpx; }
.f { flex: 1 1 110rpx; margin: 0 6rpx 8rpx 0; }
.fl { color: #8A8F98; font-size: 22rpx; }
.fv { color: #E8E6E1; font-size: 34rpx; font-weight: 600; line-height: 1.2; }
.bar { height: 6rpx; background: rgba(255,255,255,0.08); border-radius: 3rpx; overflow: hidden; }
.fill { height: 6rpx; background: #C89B5A; border-radius: 3rpx; }

.ops { display: flex; margin-top: 12rpx; }
.btn {
  flex: 1; margin-right: 12rpx; height: 76rpx; line-height: 76rpx; text-align: center;
  border-radius: 14rpx; background: rgba(255,255,255,0.08); color: #E8E6E1; font-size: 26rpx;
}
.btn:last-child { margin-right: 0; }
.btn.live { background: rgba(200,155,90,0.22); color: #E3B77C; }

.drive { display: flex; align-items: center; justify-content: space-between; margin-top: 12rpx; }
.dl { color: #C9CDD4; font-size: 24rpx; }

.bleline { color: #8A8F98; font-size: 22rpx; margin-top: 6rpx; }

.logs { max-height: 150rpx; margin-top: 10rpx; }
.li { font-size: 20rpx; color: #8A8F98; line-height: 1.6; }
.lt { color: #5B6068; margin-right: 8rpx; }
.lm { color: #9AA0A8; }
